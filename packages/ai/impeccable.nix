# Impeccable - the design skill and the engine its launcher runs. One skill with
# 24 subcommands (init, shape, critique, audit, polish, live, ...) and 61
# deterministic detector rules; homes/programs/ai-skills.nix registers one
# per-harness tree for each of the four agents.
#
# Both halves are release artifacts, pinned by tag + hash: the skill as
# universal.zip (one compiled tree per harness) and the engine as a static-pie
# binary, so there is no patchelf step. $out/bin/impeccable is also the CLI on
# PATH for `impeccable detect`; the skill does not depend on that, because every
# variant carries a wrapper at the path its launcher probes first,
# scripts/bin/<os>-<arch>/impeccable.
#
# That wrapper is where the update check is turned off: a store path cannot
# update itself, and the check would otherwise write ~/.impeccable/update-check.json
# and send the agent to `npx impeccable update`. DO_NOT_TRACK is the same choice
# for the roll API's anonymous choice record, made once here instead of in four
# harness configs.
#
# Do NOT run `impeccable install`, `impeccable update` or `npx impeccable install`:
# each writes ~/.claude/skills, ~/.codex/skills, ~/.config/opencode/skills and
# ~/.claude/agents, all generated by homes/programs/*.nix.
{
  lib,
  stdenvNoCC,
  fetchurl,
  unzip,
}:

let
  version = "4.7.0";
  engineVersion = "0.1.16";

  # A missing pair is a loud evaluation error rather than an x64 binary on an
  # ARM host.
  platform =
    {
      x86_64-linux = "linux-x64";
      aarch64-linux = "linux-arm64";
      x86_64-darwin = "darwin-x64";
      aarch64-darwin = "darwin-arm64";
    }
    .${stdenvNoCC.hostPlatform.system}
      or (throw "impeccable: no engine release for ${stdenvNoCC.hostPlatform.system}");

  # Only the platform this repo boots is pinned; another one needs its release
  # hash added here first.
  engineHashes = {
    linux-x64 = "sha256-qJCltLfZ157FSqdGErXpJOX1tCJgCiX96Ly9oRsDF4c=";
  };

  engine = fetchurl {
    name = "impeccable-${platform}";
    url = "https://github.com/pbakaus/impeccable/releases/download/engine-v${engineVersion}/impeccable-${platform}";
    hash = engineHashes.${platform} or (throw "impeccable: no pinned engine hash for ${platform}");
  };

  variants = [
    "claude"
    "codex"
    "opencode"
  ];
in
stdenvNoCC.mkDerivation {
  pname = "impeccable";
  inherit version;

  src = fetchurl {
    name = "universal.zip";
    url = "https://github.com/pbakaus/impeccable/releases/download/skill-v${version}/universal.zip";
    hash = "sha256-NYyLa7whE+mRC/StvbpFI2EkU+xY1WpcGxRlRBahP+M=";
  };

  nativeBuildInputs = [ unzip ];
  unpackPhase = "unzip -q $src";
  dontBuild = true;

  installPhase = ''
    mkdir -p $out/bin $out/share/impeccable
    install -Dm755 ${engine} $out/bin/impeccable

    cat > engine-wrapper <<'EOF'
    #!/bin/sh
    # Runs the pinned engine and nothing else: nix owns the version.
    export IMPECCABLE_NO_UPDATE_CHECK=1
    export DO_NOT_TRACK=1
    exec ${placeholder "out"}/bin/impeccable "$@"
    EOF

    for variant in ${lib.concatStringsSep " " variants}; do
      cp -r .$variant/skills/impeccable $out/share/impeccable/$variant
      chmod 755 $out/share/impeccable/$variant/scripts/impeccable
      install -Dm755 engine-wrapper $out/share/impeccable/$variant/scripts/bin/${platform}/impeccable
    done

    # Claude's four subagents and opencode's /impeccable command are siblings of
    # the skill tree, not inside it.
    mkdir -p $out/share/impeccable/agents $out/share/impeccable/commands
    cp .claude/agents/*.md $out/share/impeccable/agents/
    cp .opencode/commands/impeccable.md $out/share/impeccable/commands/opencode.md
  '';

  meta = {
    description = "Design skill and detector engine for AI coding agents";
    homepage = "https://impeccable.style";
    changelog = "https://github.com/pbakaus/impeccable/releases/tag/skill-v${version}";
    license = lib.licenses.asl20;
    mainProgram = "impeccable";
    # The mapping above knows the other asset names, but only this one has a
    # pinned hash and a release this repo has tested.
    platforms = [ "x86_64-linux" ];
  };
}
